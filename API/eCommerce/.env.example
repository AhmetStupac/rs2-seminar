# ===== SQL Server (used by docker-compose to configure the SQL container) =====
SQL__PASSWORD=your_sql_password
SQL__PID=Developer
SQL__DATABASE=eCommerceDb4
SQL__USER=sa

# ===== Connection String (maps to ConnectionStrings:DefaultConnection in .NET config) =====
ConnectionStrings__DefaultConnection=Server=ecommerce-sql,1433;Database=eCommerceDb4;User Id=sa;Password=your_sql_password;ConnectRetryCount=0;TrustServerCertificate=True

# ===== RabbitMQ (maps to RabbitMQ:Host / RabbitMQ:Username etc.) =====
RabbitMQ__Host=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__Username=guest
RabbitMQ__Password=guest

# ===== RabbitMQ container bootstrap credentials =====
RABBITMQ__USERNAME=guest
RABBITMQ__PASSWORD=guest

# ===== SMTP / Email (maps to EmailSettings:SmtpHost etc.) =====
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=your_email@gmail.com
EmailSettings__SmtpPassword=your_app_password
EmailSettings__FromEmail=your_email@gmail.com
EmailSettings__FromName=PersonalTrainerApp

# ===== Stripe (maps to Stripe:SecretKey and Stripe:PublishableKey) =====
Stripe__SecretKey=sk_test_xxx
Stripe__PublishableKey=pk_test_xxx

# ===== JWT (maps to TokenKey) =====
TokenKey=your_super_secret_key_at_least_64_chars

# ===== Azure Blob Storage (maps to AzureBlobStorage:ConnectionString etc.) =====
AzureBlobStorage__ConnectionString=your_azure_blob_connection_string
AzureBlobStorage__ContainerName=your_container_name
